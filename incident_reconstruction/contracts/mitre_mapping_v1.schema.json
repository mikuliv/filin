{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://incident-reconstruction/mitre_mapping_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "technique_id", "technique_name", "supporting_fact_ids", "mapping_basis", "limitations", "mapping_status"],
  "properties": {
    "schema_version": {"const": "mitre_mapping_v1"},
    "technique_id": {"type": "string", "pattern": "^T[0-9]{4}(?:\\.[0-9]{3})?$"},
    "technique_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "supporting_fact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^fact_[0-9a-f]{64}$"}},
    "mapping_basis": {"type": "string", "minLength": 1, "maxLength": 500},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "mapping_status": {"enum": ["analytical_correspondence", "insufficient_basis", "contradicted"]}
  }
}
