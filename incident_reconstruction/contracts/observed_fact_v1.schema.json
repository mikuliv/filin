{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://incident-reconstruction/observed_fact_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fact_id", "fact_type", "subject", "predicate", "value", "start_time", "end_time", "evidence_ids", "derivation_method", "limitations", "confirmation_status"],
  "properties": {
    "schema_version": {"const": "observed_fact_v1"},
    "fact_id": {"type": "string", "pattern": "^fact_[0-9a-f]{64}$"},
    "fact_type": {"enum": ["network_observation", "model_output", "episode_rule_output", "source_integrity"]},
    "subject": {"type": "string", "minLength": 1, "maxLength": 160},
    "predicate": {"enum": ["passive_event_recorded", "model_classified_as", "episode_state_reported", "component_status_reported", "source_hash_verified"]},
    "value": {"type": ["string", "integer", "number", "boolean", "null"]},
    "start_time": {"type": "string", "format": "date-time"},
    "end_time": {"type": ["string", "null"], "format": "date-time"},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^evr_[0-9a-f]{64}$"}},
    "derivation_method": {"enum": ["direct_field_copy", "contract_validation"]},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 300}, "uniqueItems": true},
    "confirmation_status": {"enum": ["source_confirmed", "source_confirmed_with_limitation"]}
  }
}
