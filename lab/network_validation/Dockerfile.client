FROM --platform=linux/amd64 python@sha256:afe189875f1d2f9b45e287834fb9f2c273a5d59d354ae4050ab9affbf0a6ba06
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH} PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
COPY lab/network_validation/__init__.py /workspace/lab/network_validation/__init__.py
COPY lab/network_validation/common_client.py /workspace/lab/network_validation/common_client.py
COPY lab/network_validation/contracts.py /workspace/lab/network_validation/contracts.py
COPY lab/network_validation/generators/__init__.py /workspace/lab/network_validation/generators/__init__.py
COPY lab/network_validation/generators/base.py /workspace/lab/network_validation/generators/base.py
COPY lab/network_validation/generators/family_a.py /workspace/lab/network_validation/generators/family_a.py
COPY lab/network_validation/generators/family_b.py /workspace/lab/network_validation/generators/family_b.py
ENTRYPOINT ["python", "-m", "lab.network_validation.common_client"]
CMD ["--help"]
