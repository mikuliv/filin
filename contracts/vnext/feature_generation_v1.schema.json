{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/feature_generation_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "generation_id", "status", "extractor", "groups", "projection_order", "missingness_policy", "legacy_compatibility", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "feature_generation_v1"}, "generation_id": {"type": "string", "pattern": "^features_[a-z0-9_]+_v[0-9]+$"},
    "status": {"enum": ["draft", "implemented", "experimentally_validated", "frozen"]},
    "extractor": {"type": "object", "additionalProperties": false, "required": ["name", "version", "source_commit", "source_digest", "deterministic"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "deterministic": {"type": "boolean"}}},
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["group_id", "group_version", "required_telemetry", "feature_names", "payload_aware"], "properties": {"group_id": {"enum": ["flow", "temporal", "dns", "http_metadata", "tls_metadata", "authentication", "host_context", "cross_session", "long_window", "graph", "service_behavior", "protocol_specific"]}, "group_version": {"type": "integer", "minimum": 1}, "required_telemetry": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "payload_aware": {"type": "boolean"}}}},
    "projection_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "missingness_policy": {"enum": ["explicit_missing_mask", "typed_missing_value", "reject_incomplete"]},
    "legacy_compatibility": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_digest", "compatibility"], "properties": {"contract_id": {"type": "string"}, "contract_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "compatibility": {"enum": ["exact_projection", "adapter_required", "incompatible"]}}}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
