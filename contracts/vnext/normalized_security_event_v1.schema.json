{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/normalized_security_event_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "stage", "source", "temporal", "entity_refs", "action", "payload", "provenance", "enrichments", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "normalized_security_event_v1"},
    "event_id": {"type": "string", "pattern": "^evt_[a-f0-9]{64}$"},
    "event_type": {"enum": ["network.flow", "network.connection", "dns.query", "http.request", "tls.handshake", "auth.attempt", "process.create", "file.activity", "security.finding", "cloud.activity", "external.normalized"]},
    "stage": {"enum": ["normalized", "enriched"]},
    "source": {"type": "object", "additionalProperties": false, "required": ["source_type", "source_product", "source_component", "collector", "collector_version"], "properties": {"source_type": {"type": "string"}, "source_product": {"type": "string"}, "source_component": {"type": "string"}, "collector": {"type": "string"}, "collector_version": {"type": "string"}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["event_timestamp", "ingest_timestamp", "ordering"], "properties": {"event_timestamp": {"type": "string", "format": "date-time"}, "ingest_timestamp": {"type": "string", "format": "date-time"}, "start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}, "duration_ms": {"type": "number", "minimum": 0}, "ordering": {"type": "object", "additionalProperties": false, "required": ["domain", "sequence"], "properties": {"domain": {"type": "string"}, "sequence": {"type": "integer", "minimum": 0}}}}},
    "entity_refs": {"type": "array", "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["role", "entity_id", "entity_type"], "properties": {"role": {"enum": ["source", "destination", "actor", "target", "parent", "subject", "resource"]}, "entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}, "entity_type": {"enum": ["host", "ip", "account", "process", "service", "file", "domain", "url", "certificate", "cloud_resource", "container"]}}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["name", "outcome", "status"], "properties": {"name": {"type": "string"}, "outcome": {"enum": ["success", "failure", "unknown"]}, "status": {"type": "string"}, "reason": {"type": "string"}}},
    "payload": {"oneOf": [{"$ref": "#/$defs/network_flow"}, {"$ref": "#/$defs/network_connection"}, {"$ref": "#/$defs/dns_query"}, {"$ref": "#/$defs/http_request"}, {"$ref": "#/$defs/tls_handshake"}, {"$ref": "#/$defs/auth_attempt"}, {"$ref": "#/$defs/process_create"}, {"$ref": "#/$defs/file_activity"}, {"$ref": "#/$defs/security_finding"}, {"$ref": "#/$defs/cloud_activity"}, {"$ref": "#/$defs/external_normalized"}]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_record_id", "raw_evidence", "transformation_chain"], "properties": {"source_record_id": {"type": "string"}, "raw_evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "artifact_type", "sha256", "size_bytes", "locator"], "properties": {"evidence_id": {"type": "string", "pattern": "^raw_[a-f0-9]{64}$"}, "artifact_type": {"enum": ["pcap", "jsonl", "log", "evtx", "journal", "api_response", "object"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size_bytes": {"type": "integer", "minimum": 0}, "locator": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+(?:/[a-zA-Z0-9_.-]+)*$"}, "record_offset": {"type": "integer", "minimum": 0}}}, "transformation_chain": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["stage", "component", "version", "input_digest", "output_digest"], "properties": {"stage": {"enum": ["parsed", "normalized", "enriched"]}, "component": {"type": "string"}, "version": {"type": "string"}, "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "output_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}}},
    "enrichments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["namespace", "kind", "value", "source_ref", "confidence", "limitations"], "properties": {"namespace": {"enum": ["asset", "environment", "geo", "reputation", "known_service", "attack_mapping_candidate", "threat_intelligence"]}, "kind": {"type": "string"}, "value": {}, "source_ref": {"type": "string"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "limitations": {"type": "array", "items": {"type": "string"}}}}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "endpoint": {"type": "object", "additionalProperties": false, "required": ["ip"], "properties": {"ip": {"type": "string"}, "port": {"type": "integer", "minimum": 0, "maximum": 65535}}},
    "network_flow": {"type": "object", "additionalProperties": false, "required": ["namespace", "source", "destination", "transport", "bytes", "packets"], "properties": {"namespace": {"const": "network.flow"}, "source": {"$ref": "#/$defs/endpoint"}, "destination": {"$ref": "#/$defs/endpoint"}, "transport": {"type": "string"}, "application_protocol": {"type": "string"}, "direction": {"enum": ["inbound", "outbound", "internal", "unknown"]}, "bytes": {"type": "integer", "minimum": 0}, "packets": {"type": "integer", "minimum": 0}, "connection_state": {"type": "string"}}},
    "network_connection": {"type": "object", "additionalProperties": false, "required": ["namespace", "source", "destination", "transport"], "properties": {"namespace": {"const": "network.connection"}, "source": {"$ref": "#/$defs/endpoint"}, "destination": {"$ref": "#/$defs/endpoint"}, "transport": {"type": "string"}, "process_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}, "connection_state": {"type": "string"}}},
    "dns_query": {"type": "object", "additionalProperties": false, "required": ["namespace", "question_name"], "properties": {"namespace": {"const": "dns.query"}, "question_name": {"type": "string"}, "question_type": {"type": "string"}, "response_code": {"type": "string"}, "answers": {"type": "array", "items": {"type": "string"}}}},
    "http_request": {"type": "object", "additionalProperties": false, "required": ["namespace", "method"], "properties": {"namespace": {"const": "http.request"}, "method": {"type": "string"}, "scheme": {"type": "string"}, "host": {"type": "string"}, "path": {"type": "string"}, "status_code": {"type": "integer", "minimum": 100, "maximum": 599}, "request_bytes": {"type": "integer", "minimum": 0}, "response_bytes": {"type": "integer", "minimum": 0}}},
    "tls_handshake": {"type": "object", "additionalProperties": false, "required": ["namespace"], "properties": {"namespace": {"const": "tls.handshake"}, "version": {"type": "string"}, "server_name": {"type": "string"}, "cipher": {"type": "string"}, "certificate_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}, "established": {"type": "boolean"}}},
    "auth_attempt": {"type": "object", "additionalProperties": false, "required": ["namespace", "account_entity_id", "authentication_type", "success"], "properties": {"namespace": {"const": "auth.attempt"}, "account_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}, "authentication_type": {"type": "string"}, "success": {"type": "boolean"}, "failure_reason": {"type": "string"}, "target_service_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}}},
    "process_create": {"type": "object", "additionalProperties": false, "required": ["namespace", "process_entity_id"], "properties": {"namespace": {"const": "process.create"}, "process_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}, "parent_process_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}}},
    "file_activity": {"type": "object", "additionalProperties": false, "required": ["namespace", "file_entity_id", "operation"], "properties": {"namespace": {"const": "file.activity"}, "file_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}, "operation": {"enum": ["create", "modify", "delete", "read", "rename"]}}},
    "security_finding": {"type": "object", "additionalProperties": false, "required": ["namespace", "finding_id", "severity", "rule_id"], "properties": {"namespace": {"const": "security.finding"}, "finding_id": {"type": "string"}, "severity": {"type": "string"}, "rule_id": {"type": "string"}, "message": {"type": "string"}}},
    "cloud_activity": {"type": "object", "additionalProperties": false, "required": ["namespace", "provider", "operation", "resource_entity_id"], "properties": {"namespace": {"const": "cloud.activity"}, "provider": {"type": "string"}, "operation": {"type": "string"}, "resource_entity_id": {"type": "string", "pattern": "^ent_[a-f0-9]{64}$"}}},
    "external_normalized": {"type": "object", "additionalProperties": false, "required": ["namespace", "contract_id", "data"], "properties": {"namespace": {"const": "external.normalized"}, "contract_id": {"type": "string"}, "data": {"type": "object"}}}
  }
}
