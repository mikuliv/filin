{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/feature_group_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "schema_id", "schema_digest", "group_id", "provider_id", "provider_version", "status", "required_telemetry", "telemetry_requirement_mode", "ordered_feature_names", "values", "missing_data", "provenance", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "feature_group_v1"}, "schema_id": {"enum": ["filin://vnext/temporal_feature_group_v1", "filin://vnext/authentication_feature_group_v1", "filin://vnext/http_behavior_feature_group_v1", "filin://vnext/dns_feature_group_v1", "filin://vnext/legacy_network_v2", "filin://vnext/network_context_feature_group_v1", "filin://vnext/interaction_graph_feature_group_v1"]},
    "schema_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "group_id": {"enum": ["temporal_v1", "authentication_v1", "http_behavior_v1", "dns_v1", "legacy_network_v2", "network_context_v1", "interaction_graph_v1"]}, "provider_id": {"type": "string"}, "provider_version": {"type": "string"},
    "status": {"enum": ["AVAILABLE", "UNAVAILABLE_TELEMETRY", "INSUFFICIENT_DATA", "UNSUPPORTED", "INVALID_INPUT"]},
    "required_telemetry": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "telemetry_requirement_mode": {"enum": ["any", "all"]},
    "ordered_feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "values": {"type": "object", "additionalProperties": {"type": ["number", "null"]}},
    "missing_data": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["feature_name", "status", "reason"], "properties": {"feature_name": {"type": "string"}, "status": {"enum": ["UNAVAILABLE_TELEMETRY", "INSUFFICIENT_DATA", "UNSUPPORTED", "INVALID_INPUT"]}, "reason": {"type": "string"}}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["observation_bundle_id", "observation_digest", "event_refs", "algorithm"], "properties": {"observation_bundle_id": {"type": "string"}, "observation_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "event_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "algorithm": {"type": "string"}}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
