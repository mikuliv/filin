{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/telemetry_capability_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "status", "sources", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "telemetry_capability_v1"},
    "catalog_id": {"type": "string", "pattern": "^telemetry_[a-z0-9_]+_v[0-9]+$"},
    "status": {"enum": ["planned", "implemented", "experimentally_validated"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_type", "product", "adapter", "maturity", "capabilities", "limitations"],
        "properties": {
          "source_id": {"type": "string"},
          "source_type": {"type": "string"},
          "product": {"type": "string"},
          "adapter": {"type": "string"},
          "maturity": {"enum": ["planned", "implemented", "experimentally_validated"]},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["telemetry_type", "field_paths", "payload_visibility", "maturity"],
              "properties": {
                "telemetry_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"},
                "field_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"}},
                "payload_visibility": {"enum": ["none", "metadata_only", "partial", "full"]},
                "maturity": {"enum": ["planned", "implemented", "experimentally_validated"]}
              }
            }
          },
          "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
