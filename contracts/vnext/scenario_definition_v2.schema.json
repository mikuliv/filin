{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/scenario_definition_v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "purpose_ru", "status", "taxonomy_node_id", "scenario_variant", "generator_requirements", "telemetry_expectations", "environment_requirements", "parameter_constraints", "intensity_model", "expected_observable_behavior", "forbidden_observable_fields", "forbidden_marker_patterns", "counterfactual_refs", "hard_benign_analogue_refs", "ground_truth_policy", "limitations", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "scenario_definition_v2"}, "scenario_id": {"type": "string", "pattern": "^scenario_[a-z0-9_]+$"},
    "purpose_ru": {"type": "string", "minLength": 1}, "status": {"enum": ["planned", "implemented", "experimentally_validated"]}, "taxonomy_node_id": {"type": "string"}, "scenario_variant": {"type": "string"},
    "generator_requirements": {"type": "object", "additionalProperties": false, "required": ["allowed_generator_ids", "implementation_separation_required"], "properties": {"allowed_generator_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "implementation_separation_required": {"type": "boolean"}}},
    "telemetry_expectations": {"type": "object", "additionalProperties": false, "required": ["required", "useful", "expected_event_types"], "properties": {"required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "useful": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "expected_event_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
    "environment_requirements": {"type": "object", "additionalProperties": false, "required": ["services", "target_capabilities"], "properties": {"services": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "target_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "parameter_constraints": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "array"]}},
    "intensity_model": {"type": "object", "additionalProperties": false, "required": ["dimension_ids", "default_profile"], "properties": {"dimension_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "default_profile": {"type": "object"}}},
    "expected_observable_behavior": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_observable_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["attack_label", "taxonomy_node_id", "scenario_id", "scenario_variant", "generator_id", "realization_id", "expected_attack_family", "ground_truth", "ground_truth_ref", "label", "label_id"]}},
    "forbidden_marker_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "counterfactual_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "hard_benign_analogue_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "ground_truth_policy": {"type": "object", "additionalProperties": false, "required": ["storage_class", "observable_access", "prediction_access"], "properties": {"storage_class": {"const": "external_sealed_ground_truth"}, "observable_access": {"const": "forbidden"}, "prediction_access": {"const": "forbidden"}}},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
