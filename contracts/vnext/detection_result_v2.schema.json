{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/detection_result_v2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "feature_bundle_ref", "stages", "known_behavior", "hypotheses", "detector_outputs", "abstention", "evidence_refs", "ground_truth_used", "limitations", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "detection_result_v2"}, "result_id": {"type": "string", "pattern": "^detection_[a-f0-9]{64}$"}, "feature_bundle_ref": {"type": "object", "additionalProperties": false, "required": ["feature_bundle_id", "canonical_digest"], "properties": {"feature_bundle_id": {"type": "string"}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "stages": {"type": "object", "additionalProperties": false, "required": ["suspiciousness", "behavioral_family", "specific_behavior"], "properties": {"suspiciousness": {"enum": ["benign_like", "suspicious", "insufficient_evidence"]}, "behavioral_family": {"type": ["string", "null"]}, "specific_behavior": {"type": ["string", "null"]}}}, "known_behavior": {"type": "boolean"},
    "hypotheses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["taxonomy_node_id", "support_score", "rank", "evidence_refs", "supporting_feature_groups", "contradictory_evidence_refs", "detector_sources"], "properties": {"taxonomy_node_id": {"type": "string"}, "support_score": {"type": "number"}, "rank": {"type": "integer", "minimum": 1}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "supporting_feature_groups": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "contradictory_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "detector_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}},
    "detector_outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["detector_id", "score", "decision", "distance", "artifact_digest"], "properties": {"detector_id": {"type": "string"}, "score": {"type": "number"}, "decision": {"type": "string"}, "distance": {"type": ["number", "null"]}, "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "abstention": {"type": "object", "additionalProperties": false, "required": ["abstained", "reasons", "signals"], "properties": {"abstained": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}}, "signals": {"type": "object", "additionalProperties": {"type": ["number", "boolean", "string"]}}}},
    "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "ground_truth_used": {"const": false}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
