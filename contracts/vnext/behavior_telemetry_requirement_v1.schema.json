{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/behavior_telemetry_requirement_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mapping_id", "taxonomy_id", "status", "requirements", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "behavior_telemetry_requirement_v1"},
    "mapping_id": {"type": "string"}, "taxonomy_id": {"type": "string"},
    "status": {"enum": ["planned", "implemented", "experimentally_validated"]},
    "requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["taxonomy_node_id", "required_all", "required_any", "useful", "hard_benign_analogue_node_ids", "detection_limitations", "forbidden_claims"], "properties": {
      "taxonomy_node_id": {"type": "string"},
      "required_all": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "required_any": {"type": "array", "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}},
      "useful": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "hard_benign_analogue_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "detection_limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "forbidden_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
    }}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
