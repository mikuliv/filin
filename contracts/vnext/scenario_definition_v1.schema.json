{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/scenario_definition_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "status", "taxonomy_path", "implementation", "dimensions", "required_telemetry", "holdout_dimensions", "counterfactual_refs", "hard_benign_analogue_refs", "seed", "ground_truth_ref", "limitations"],
  "properties": {
    "schema_version": {"const": "scenario_definition_v1"}, "scenario_id": {"type": "string", "pattern": "^scenario_[a-z0-9_]+$"},
    "status": {"enum": ["draft", "implemented", "experimentally_validated"]},
    "taxonomy_path": {"type": "array", "minItems": 3, "maxItems": 4, "items": {"type": "string"}},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["generator_family", "implementation_variant", "source_digest"], "properties": {"generator_family": {"type": "string"}, "implementation_variant": {"type": "string"}, "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "dimensions": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}},
    "required_telemetry": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "holdout_dimensions": {"type": "array", "uniqueItems": true, "items": {"enum": ["generator_family", "implementation_variant", "scenario_variant", "infrastructure", "target", "intensity", "protocol_implementation"]}},
    "counterfactual_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "hard_benign_analogue_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "seed": {"type": "integer", "minimum": 0},
    "ground_truth_ref": {"type": "object", "additionalProperties": false, "required": ["storage_class", "label_id"], "properties": {"storage_class": {"const": "external_sealed_label_vault"}, "label_id": {"type": "string"}}},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
  }
}
