{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/generator_capability_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "status", "generators", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "generator_capability_v1"}, "registry_id": {"type": "string"}, "status": {"enum": ["planned", "implemented", "experimentally_validated"]},
    "generators": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["generator_id", "implementation_ref", "adapter_status", "supported_taxonomy_nodes", "required_environment_capabilities", "required_telemetry", "parameter_schema_ref", "seed_policy", "emitted_observable_activity", "supported_dimensions", "limitations"], "properties": {
      "generator_id": {"type": "string"}, "implementation_ref": {"type": "string"}, "adapter_status": {"enum": ["planned", "implemented", "experimentally_validated"]},
      "supported_taxonomy_nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "required_environment_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "required_telemetry": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "parameter_schema_ref": {"type": "string"},
      "seed_policy": {"type": "object", "additionalProperties": false, "required": ["deterministic", "algorithm", "same_seed_same_realization"], "properties": {"deterministic": {"const": true}, "algorithm": {"type": "string"}, "same_seed_same_realization": {"const": true}}},
      "emitted_observable_activity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "supported_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
    }}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
