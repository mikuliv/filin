{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/feature_provider_registry_v1", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "registry_id", "status", "providers", "canonical_digest"],
  "properties": {"schema_version": {"const": "feature_provider_registry_v1"}, "registry_id": {"type": "string"}, "status": {"enum": ["planned", "implemented", "experimentally_validated"]},
    "providers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider_id", "group_id", "schema_id", "schema_digest", "version", "required_telemetry", "telemetry_requirement_mode", "supported_event_types", "supported_behavior_families", "ordered_feature_names", "missing_data_policy", "deterministic", "maturity"], "properties": {
      "provider_id": {"type": "string"}, "group_id": {"type": "string"}, "schema_id": {"type": "string"}, "schema_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "version": {"type": "string"}, "required_telemetry": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "telemetry_requirement_mode": {"enum": ["any", "all"]}, "supported_event_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "supported_behavior_families": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "ordered_feature_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "missing_data_policy": {"const": "explicit_typed_status"}, "deterministic": {"const": true}, "maturity": {"enum": ["planned", "implemented", "experimentally_validated", "frozen"]}
    }}}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
