{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/scenario_realization_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "realization_id", "scenario_ref", "generator_id", "seed", "resolved_parameters", "environment_binding", "expected_observable_types", "ground_truth_ref", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "scenario_realization_v1"}, "realization_id": {"type": "string", "pattern": "^real_[a-f0-9]{64}$"},
    "scenario_ref": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "canonical_digest"], "properties": {"scenario_id": {"type": "string"}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "generator_id": {"type": "string"}, "seed": {"type": "integer", "minimum": 0}, "resolved_parameters": {"type": "object"},
    "environment_binding": {"type": "object", "additionalProperties": false, "required": ["environment_id", "services", "target_id"], "properties": {"environment_id": {"type": "string"}, "services": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "target_id": {"type": "string"}}},
    "expected_observable_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "ground_truth_ref": {"type": "object", "additionalProperties": false, "required": ["vault_id", "label_id"], "properties": {"vault_id": {"type": "string"}, "label_id": {"type": "string"}}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
