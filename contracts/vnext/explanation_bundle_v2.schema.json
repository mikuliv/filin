{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/explanation_bundle_v2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "explanation_id", "detection_result_ref", "layers", "evidence_items", "hypothesis_explanations", "ground_truth_used", "limitations", "canonical_digest"],
  "properties": {"schema_version": {"const": "explanation_bundle_v2"}, "explanation_id": {"type": "string", "pattern": "^explanation_[a-f0-9]{64}$"}, "detection_result_ref": {"type": "string"},
    "layers": {"type": "object", "additionalProperties": false, "required": ["raw_evidence_refs", "feature_evidence_refs", "detector_rationale_refs", "hypothesis_refs"], "properties": {"raw_evidence_refs": {"type": "array", "items": {"type": "string"}}, "feature_evidence_refs": {"type": "array", "items": {"type": "string"}}, "detector_rationale_refs": {"type": "array", "items": {"type": "string"}}, "hypothesis_refs": {"type": "array", "items": {"type": "string"}}}},
    "evidence_items": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "evidence_type", "source_feature", "observed_value", "reference", "direction", "linked_hypothesis", "template_key"], "properties": {"evidence_id": {"type": "string"}, "evidence_type": {"enum": ["raw", "feature", "detector_rationale", "hypothesis"]}, "source_feature": {"type": "string"}, "observed_value": {"type": ["number", "string", "boolean", "null"]}, "reference": {"type": "string"}, "direction": {"enum": ["supports", "contradicts", "context_only"]}, "linked_hypothesis": {"type": ["string", "null"]}, "template_key": {"type": "string"}}}},
    "hypothesis_explanations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["taxonomy_node_id", "supporting_refs", "contradicting_refs"], "properties": {"taxonomy_node_id": {"type": "string"}, "supporting_refs": {"type": "array", "items": {"type": "string"}}, "contradicting_refs": {"type": "array", "items": {"type": "string"}}}}}, "ground_truth_used": {"const": false}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
