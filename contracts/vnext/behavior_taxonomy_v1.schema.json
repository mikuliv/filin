{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/behavior_taxonomy_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_id", "taxonomy_version", "status", "nodes", "limitations"],
  "properties": {
    "schema_version": {"const": "behavior_taxonomy_v1"},
    "taxonomy_id": {"type": "string", "pattern": "^taxonomy_[a-z0-9_]+$"},
    "taxonomy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "reviewed", "frozen"]},
    "nodes": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["node_id", "parent_id", "level", "disposition", "title", "description", "observability", "payload_requirement", "capability_status", "legacy_bindings", "limitations"],
        "properties": {
          "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$"},
          "parent_id": {"type": ["string", "null"]},
          "level": {"enum": ["superclass", "behavioral_family", "behavior", "scenario_variant"]},
          "disposition": {"enum": ["benign", "malicious", "dual_use"]},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "observability": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["flow", "dns", "http_metadata", "tls_metadata", "authentication", "host", "payload", "temporal", "graph", "service_context"]}},
          "payload_requirement": {"enum": ["not_required", "optional", "required"]},
          "capability_status": {"enum": ["planned", "implemented", "experimentally_validated"]},
          "legacy_bindings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
