{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/feature_bundle_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "feature_bundle_id", "observation_ref", "raw_evidence_refs", "groups", "missing_groups", "provider_registry_digest", "ground_truth_used", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "feature_bundle_v1"}, "feature_bundle_id": {"type": "string", "pattern": "^feature_bundle_[a-f0-9]{64}$"},
    "observation_ref": {"type": "object", "additionalProperties": false, "required": ["bundle_id", "canonical_digest"], "properties": {"bundle_id": {"type": "string"}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "raw_evidence_refs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "sha256"], "properties": {"evidence_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "missing_groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["group_id", "status", "reason"], "properties": {"group_id": {"type": "string"}, "status": {"enum": ["UNAVAILABLE_TELEMETRY", "INSUFFICIENT_DATA", "UNSUPPORTED", "INVALID_INPUT"]}, "reason": {"type": "string"}}}},
    "provider_registry_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "ground_truth_used": {"const": false}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
