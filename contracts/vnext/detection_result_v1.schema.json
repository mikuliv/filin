{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/detection_result_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "result_id", "subject_id", "evidence_refs", "detector_outputs", "disposition", "knownness", "taxonomy_hypotheses", "confidence", "abstention", "ground_truth_used", "limitations", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "detection_result_v1"}, "result_id": {"type": "string", "pattern": "^detection_[a-f0-9]{64}$"}, "subject_id": {"type": "string"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "detector_outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["detector_id", "detector_type", "artifact_digest", "score", "decision"], "properties": {"detector_id": {"type": "string"}, "detector_type": {"enum": ["deterministic_rule", "sigma", "anomaly", "classifier", "behavioral", "temporal", "graph"]}, "artifact_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "score": {"type": "number"}, "decision": {"type": "string"}}}},
    "disposition": {"enum": ["benign", "suspicious", "malicious", "indeterminate"]}, "knownness": {"enum": ["known", "unknown", "uncertain"]},
    "taxonomy_hypotheses": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["node_id", "rank", "confidence"], "properties": {"node_id": {"type": "string"}, "rank": {"type": "integer", "minimum": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "confidence": {"type": "object", "additionalProperties": false, "required": ["value", "calibration_protocol_ref", "calibration_digest"], "properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}, "calibration_protocol_ref": {"type": "string"}, "calibration_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "abstention": {"type": "object", "additionalProperties": false, "required": ["abstained", "policy_ref", "reason"], "properties": {"abstained": {"type": "boolean"}, "policy_ref": {"type": "string"}, "reason": {"type": ["string", "null"]}}},
    "ground_truth_used": {"const": false}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
