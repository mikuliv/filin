{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filin://vnext/experimental_dimension_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "status", "dimensions", "behavior_designs", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "experimental_dimension_v1"},
    "registry_id": {"type": "string"}, "status": {"enum": ["planned", "implemented", "experimentally_validated"]},
    "dimensions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["dimension_id", "value_type", "domain", "description_ru"], "properties": {
      "dimension_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "value_type": {"enum": ["integer", "number", "string", "boolean"]},
      "domain": {"type": "object", "additionalProperties": false, "properties": {"minimum": {"type": "number"}, "maximum": {"type": "number"}, "enum": {"type": "array", "minItems": 1, "uniqueItems": true}}},
      "description_ru": {"type": "string"}
    }}},
    "behavior_designs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["taxonomy_node_id", "required_dimensions", "optional_dimensions", "forbidden_dimensions"], "properties": {
      "taxonomy_node_id": {"type": "string"}, "required_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "optional_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "forbidden_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
    }}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
