{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "filin://vnext/execution_recovery_manifest_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "recovery_generation", "execution_package", "images", "restore_policy", "verification", "canonical_digest"],
  "properties": {
    "schema_version": {"const": "execution_recovery_manifest_v1"}, "recovery_generation": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
    "execution_package": {"type": "object", "additionalProperties": false, "required": ["package_id", "canonical_digest", "source_commit"], "properties": {"package_id": {"type": "string"}, "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "images": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["logical_name", "tag", "platform", "manifest_digest", "config_digest", "base_image_digest", "build_input_digest", "dockerfile_digest", "source_commit", "archive_path", "archive_sha256", "build_metadata"], "properties": {"logical_name": {"type": "string"}, "tag": {"type": "string", "pattern": "^[^:]+:[^:]+$"}, "platform": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9_]+$"}, "manifest_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "config_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "base_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "build_input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "dockerfile_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "archive_path": {"type": "string", "pattern": "^images/[A-Za-z0-9._/-]+\\.(?:tar|oci)$"}, "archive_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "build_metadata": {"type": "object"}}}},
    "restore_policy": {"type": "object", "additionalProperties": false, "required": ["network_pull", "floating_base_images", "automatic_rebuild", "automatic_lock_rewrite", "identity_mismatch"], "properties": {"network_pull": {"const": "forbidden"}, "floating_base_images": {"const": "forbidden"}, "automatic_rebuild": {"const": "forbidden"}, "automatic_lock_rewrite": {"const": "forbidden"}, "identity_mismatch": {"const": "fail_closed"}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["archive_checksums", "loaded_manifest_identity", "loaded_config_identity", "clean_host_restore_required"], "properties": {"archive_checksums": {"const": true}, "loaded_manifest_identity": {"const": true}, "loaded_config_identity": {"const": true}, "clean_host_restore_required": {"const": true}}},
    "canonical_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
