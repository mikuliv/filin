{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:filin:manual_review_decision_v1",
  "title": "manual_review_decision_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "no_final_determination",
    "no_automatic_action"
  ],
  "properties": {
    "schema_version": {
      "const": "manual_review_decision_v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safety": {
      "type": "object"
    },
    "payload": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "no_final_determination": {
      "const": true
    },
    "no_automatic_action": {
      "const": true
    }
  }
}
