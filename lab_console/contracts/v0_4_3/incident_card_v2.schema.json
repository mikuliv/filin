{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:filin:incident_card_v2",
  "title": "incident_card_v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "incident_card_v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safety": {
      "type": "object"
    },
    "payload": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "source_references": {
      "type": "object"
    }
  }
}
