{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filin.local/contracts/v0_4_4/laboratory_case_summary_v1.schema.json",
  "title": "laboratory_case_summary_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "card_id",
    "manifest_sha256",
    "semantic_sha256"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "card_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "semantic_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
