{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filin.local/contracts/v0_4_4/hypothesis_operator_view_v1.schema.json",
  "title": "hypothesis_operator_view_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hypothesis_id",
    "status",
    "supporting_items"
  ],
  "properties": {
    "hypothesis_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "status": {
      "enum": [
        "possible",
        "indeterminate",
        "partially_supported",
        "contradicted"
      ]
    },
    "supporting_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
      }
    }
  }
}
