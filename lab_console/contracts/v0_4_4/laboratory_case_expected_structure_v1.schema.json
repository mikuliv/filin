{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filin.local/contracts/v0_4_4/laboratory_case_expected_structure_v1.schema.json",
  "title": "laboratory_case_expected_structure_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "fact_count",
    "forced_winner"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "fact_count": {
      "type": "integer",
      "minimum": 1
    },
    "forced_winner": {
      "const": false
    }
  }
}
