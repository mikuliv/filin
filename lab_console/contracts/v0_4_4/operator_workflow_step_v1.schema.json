{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filin.local/contracts/v0_4_4/operator_workflow_step_v1.schema.json",
  "title": "operator_workflow_step_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step_id",
    "title",
    "mandatory"
  ],
  "properties": {
    "step_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "not": {
        "pattern": "[<>]"
      }
    },
    "mandatory": {
      "type": "boolean"
    }
  }
}
