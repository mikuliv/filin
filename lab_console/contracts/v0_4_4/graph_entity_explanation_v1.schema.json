{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://filin.local/contracts/v0_4_4/graph_entity_explanation_v1.schema.json",
  "title": "graph_entity_explanation_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "basis",
    "causal"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,180}$"
    },
    "basis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "not": {
        "pattern": "[<>]"
      }
    },
    "causal": {
      "const": false
    }
  }
}
